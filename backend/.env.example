# ============================================
# AI Haber Ajansı — Backend Environment Variables
# ============================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ============================================

# --- REQUIRED: Server Configuration ---
NODE_ENV=development
PORT=3001

# --- REQUIRED: Database (PostgreSQL 16+) ---
DATABASE_URL=postgresql://postgres:your_password_here@127.0.0.1:5432/news_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=news_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- REQUIRED: JWT Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_64_character_hex_string_here_minimum_32_bytes_recommended

# --- REQUIRED: Redis Cache ---
REDIS_URL=redis://127.0.0.1:6379

# --- REQUIRED: LLM API Keys (Gemini Primary) ---
# Get from: https://makersuite.google.com/app/apikeys
LLM_API_KEY=AIzaSy_YOUR_ACTUAL_KEY_HERE_1
LLM_API_KEY_2=AIzaSy_YOUR_ACTUAL_KEY_HERE_2
LLM_API_KEY_3=AIzaSy_YOUR_ACTUAL_KEY_HERE_3
LLM_API_KEY_4=AIzaSy_YOUR_ACTUAL_KEY_HERE_4
LLM_API_KEY_5=AIzaSy_YOUR_ACTUAL_KEY_HERE_5
LLM_API_KEY_6=AIzaSy_YOUR_ACTUAL_KEY_HERE_6

# --- LLM Configuration ---
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-2.5-flash
LLM_FALLBACK_PROVIDER=ollama
LLM_FALLBACK_MODEL=qwen3:8b
LLM_BASE_URL=http://host.docker.internal:11434

# --- Logging ---
LOG_LEVEL=info

# --- CORS Configuration ---
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Admin API Key (Legacy - Will be deprecated in favor of JWT) ---
# Leave empty to disable legacy mode
ADMIN_API_KEY=

# --- Social Media Integration (Default: Mock Mode) ---
SOCIAL_MEDIA_MODE=mock

# Optional: Twitter/X
# TWITTER_API_KEY=your_twitter_api_key
# TWITTER_API_SECRET=your_twitter_api_secret
# TWITTER_ACCESS_TOKEN=your_twitter_access_token
# TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# Optional: LinkedIn
# LINKEDIN_ACCESS_TOKEN=your_linkedin_token

# Optional: Telegram
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHANNEL_ID=your_telegram_channel_id

# --- Feature Flags ---
LLM_PIPELINE_ENABLED=true
LLM_DAILY_QUOTA=100

# --- Gemini Specific ---
GEMINI_API_KEY=AIzaSy_YOUR_ACTUAL_KEY_HERE_1
GEMINI_MODEL_NAME=gemini-2.5-flash
