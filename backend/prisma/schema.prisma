// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Kullanıcılar ---
model Kullanici {
  id                  Int       @id @default(autoincrement())
  email               String    @unique
  sifreHash           String    @map("sifre_hash")
  ad                  String
  tercihKategorileri  String[]  @map("tercih_kategorileri")
  olusturulmaTarihi   DateTime  @default(now()) @map("olusturulma_tarihi")

  cerezTercihi        CerezTercihi?
  okumaGecmisi        OkumaGecmisi[]

  @@map("kullanicilar")
}

// --- Kategoriler ---
model Kategori {
  id        Int     @id @default(autoincrement())
  ad        String  @unique
  slug      String  @unique
  renkKodu  String  @map("renk_kodu")
  ikon      String?

  haberler            Haber[]
  manuelValidasyonlar ManuelValidasyon[]
  nbDisputes          DisputeQueue[] @relation("nb")
  llmDisputes         DisputeQueue[] @relation("llm")
  adminKararDisputes  DisputeQueue[] @relation("admin_karar")

  @@map("kategoriler")
}

// --- Haberler ---
model Haber {
  id                  Int       @id @default(autoincrement())
  baslik              String
  slug                String    @unique
  metaAciklama        String?   @map("meta_aciklama")
  icerik              String?
  kategoriId          Int       @map("kategori_id")
  kaynakUrl           String?   @map("kaynak_url")
  gorselUrl           String?   @map("gorsel_url")
  sentiment           String?   // Pozitif | Negatif | Nötr
  okumaSuresiDakika   Float?    @map("okuma_suresi_dakika")
  yayinlanmaTarihi    DateTime  @default(now()) @map("yayinlanma_tarihi")
  goruntulemeSayisi   Int       @default(0) @map("goruntulenme_sayisi")
  durum               String    @default("ham") // ham | hazir | yayinda
  mlConfidence        Float?    @map("ml_confidence")
  llmProvider         String?   @map("llm_provider") // 'pending' | 'gemini' | 'ollama' | 'failed' | 'dead' | 'none'
  kategoriDogrulandi  Boolean   @default(false) @map("kategori_dogrulandi")
  augmentedAt         DateTime? @map("augmented_at")

  // --- Consensus Pipeline alanları ---
  nbKategoriId        Int?      @map("nb_kategori_id")   // NB orijinal tahmini (frozen)
  llmKategoriId       Int?      @map("llm_kategori_id")  // LLM kategorisi
  llmRetryCount       Int       @default(0) @map("llm_retry_count") // LLM retry sayacı (max 3)

  kategori            Kategori          @relation(fields: [kategoriId], references: [id])
  okumaGecmisi        OkumaGecmisi[]
  manuelValidasyonlar ManuelValidasyon[]
  disputeQueue        DisputeQueue?

  @@index([durum])                          // En sık filtre: status=hazir
  @@index([yayinlanmaTarihi(sort: Desc)])   // Sıralama: en yeni önce
  @@index([kategoriId])                     // Kategori filtreleme
  @@index([durum, yayinlanmaTarihi(sort: Desc)])  // Kombine: hazir haberler tarih sırası
  @@index([kategoriId, durum, yayinlanmaTarihi(sort: Desc)]) // Kategori + durum + tarih sıralama
  @@index([durum, sentiment, yayinlanmaTarihi(sort: Desc)]) // Sentiment admin istatistikleri/trend
  @@index([augmentedAt])
  @@map("haberler")
}

model DisputeQueue {
  id                   Int       @id @default(autoincrement())
  haberId              Int       @unique @map("haber_id")
  haber                Haber     @relation(fields: [haberId], references: [id], onDelete: Cascade)
  nbKategoriId         Int?      @map("nb_kategori_id")
  nbKategori           Kategori? @relation("nb", fields: [nbKategoriId], references: [id])
  llmKategoriId        Int?      @map("llm_kategori_id")
  llmKategori          Kategori? @relation("llm", fields: [llmKategoriId], references: [id])
  nbGuvenSkoru         Float?    @map("nb_guven_skoru")
  llmGuvenSkoru        Float?    @map("llm_guven_skoru")
  batchNumber          Int       @map("batch_number")
  durum                String    @default("bekliyor") // bekliyor | cozuldu | atildi
  adminKararKategoriId Int?      @map("admin_karar_kategori_id")
  adminKararKategori   Kategori? @relation("admin_karar", fields: [adminKararKategoriId], references: [id])
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  resolvedAt           DateTime? @map("resolved_at") @db.Timestamptz
  resolvedBy           String?   @map("resolved_by")

  @@map("dispute_queue")
}

model BatchAuditLog {
  id                   Int      @id @default(autoincrement())
  batchNumber          Int      @map("batch_number")
  phase                String   // 'pre' or 'post'
  timestamp            DateTime @default(now()) @db.Timestamptz
  haberCount           Int?     @map("haber_count")
  kategoriDistribution Json?    @map("kategori_distribution") // {"Gündem": 45, "Spor": 120, ...}
  categoryDominancePct Float?   @map("category_dominance_pct")
  imbalanceRatio       Float?   @map("imbalance_ratio")
  mlAccuracy           Float?   @map("ml_accuracy")
  trainSize            Int?     @map("train_size")
  testSize             Int?     @map("test_size")
  status               String   // 'in_progress' | 'success' | 'rolled_back'
  notes                String?

  @@unique([batchNumber, phase])
  @@map("batch_audit_log")
}

// --- Çerez Tercihleri ---
model CerezTercihi {
  id                    Int       @id @default(autoincrement())
  kullaniciId           Int       @unique @map("kullanici_id")
  analitikIzni          Boolean   @default(false) @map("analitik_izni")
  kisisellesirmeIzni    Boolean   @default(false) @map("kisisellesirme_izni")
  guncellemeTarihi      DateTime  @default(now()) @map("guncelleme_tarihi")

  kullanici             Kullanici @relation(fields: [kullaniciId], references: [id])

  @@map("cerez_tercihleri")
}

// --- Okuma Geçmişi ---
model OkumaGecmisi {
  id            Int       @id @default(autoincrement())
  kullaniciId   Int       @map("kullanici_id")
  haberId       Int       @map("haber_id")
  okumaTarihi   DateTime  @default(now()) @map("okuma_tarihi")

  kullanici     Kullanici @relation(fields: [kullaniciId], references: [id])
  haber         Haber     @relation(fields: [haberId], references: [id])

  @@map("okuma_gecmisi")
}

// --- Dead Letter Queue ---
model DeadLetterQueue {
  id            Int       @id @default(autoincrement())
  workflowName  String    @map("workflow_name")
  payload       Json
  errorMessage  String?   @map("error_message")
  retryCount    Int       @default(0) @map("retry_count")
  maxRetries    Int       @default(3) @map("max_retries")
  nextRetryAt   DateTime? @map("next_retry_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  resolvedAt    DateTime? @map("resolved_at")

  @@map("dead_letter_queue")
}

// --- LLM Token Kullanımı Takibi ---
model LlmKullanim {
  id                  Int       @id @default(autoincrement())
  saglayici           String    // gemini | anthropic | openai | ollama
  girisTokenSayisi    Int       @map("giris_token_sayisi")
  cikisTokenSayisi    Int       @map("cikis_token_sayisi")
  tahminiMaliyet      Float?    @map("tahmini_maliyet") // USD
  tarih               DateTime  @default(now())
  durum               String    @default("basarili") // basarili | hata | zaman_asimi
  hataMesaji          String?   @map("hata_mesaji")

  @@index([saglayici])
  @@index([tarih(sort: Desc)])
  @@index([saglayici, tarih(sort: Desc)])
  @@map("llm_kullanm")
}

// --- Manuel Validasyon Audit Trail (Sprint 3) ---
model ManuelValidasyon {
  id                  Int       @id @default(autoincrement())
  haberId             Int       @map("haber_id")
  haber               Haber     @relation(fields: [haberId], references: [id], onDelete: Cascade)
  eskiKategoriId      Int?      @map("eski_kategori_id")
  yeniKategoriId      Int       @map("yeni_kategori_id")
  yeniKategori        Kategori  @relation(fields: [yeniKategoriId], references: [id])
  dogrulayanEmail     String?   @map("dogrulayan_email")  // "cli" veya kullanici email
  kararTuru           String    @map("karar_turu")        // "confirm" | "correct" | "skip"
  batchId             String    @map("batch_id")          // Batch UUID tracking
  olusturulmaTarihi   DateTime  @default(now()) @map("olusturulma_tarihi")
  notlar              String?

  @@index([batchId])
  @@index([olusturulmaTarihi(sort: Desc)])
  @@index([haberId])
  @@map("manuel_validasyonlar")
}

// --- ML Model Durumu ---
model ModelState {
  id          Int      @id
  version     Int      @default(1)
  modelData   Json     @map("model_data")
  lrModelData Json?    @map("lr_model_data")
  accuracy    Float?
  trainedAt   DateTime @default(now()) @map("trained_at")
  sampleCount Int      @default(0) @map("sample_count")

  @@map("model_state")
}
